---
import { Font, getImage } from "astro:assets";
import type { ImageMetadata } from "astro";

import "../styles/global.css";

import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import ogDefault from "@/assets/og-default.png";
import {
  SITE_TITLE,
  SITE_DESCRIPTION,
  SITE_URL,
  SOCIAL_LINKS,
} from "@/consts";

type Props = {
  title?: string;
  description?: string;
  /** Imagem de compartilhamento; sem ela, usa src/assets/og-default.png. */
  image?: ImageMetadata;
  imageAlt?: string;
  type?: "website" | "article";
  publishDate?: Date;
  updatedDate?: Date;
  /** Seção (categoria) e tags do artigo: article:section/tag e JSON-LD. */
  section?: string;
  tags?: string[];
  /** Páginas que não devem ser indexadas (ex.: 404). */
  noindex?: boolean;
  class?: string;
};

const {
  title,
  description = SITE_DESCRIPTION,
  image,
  imageAlt,
  type = "website",
  publishDate,
  updatedDate,
  section,
  tags = [],
  noindex = false,
  class: classname,
} = Astro.props;

const pageTitle = title ? `${title} | ${SITE_TITLE}` : SITE_TITLE;
const canonicalURL = new URL(Astro.url.pathname, SITE_URL).toString();

// Imagem social no tamanho recomendado (1200×630), recortada ao centro.
// O arquivo original não muda; é só uma cópia gerada no build.
const ogImage = await getImage({
  src: image ?? ogDefault,
  width: 1200,
  height: 630,
  fit: "cover",
  position: "center",
  format: "jpg",
});
const imageURL = new URL(ogImage.src, SITE_URL).toString();
const ogImageAlt = imageAlt ?? (image ? (title ?? SITE_TITLE) : SITE_TITLE);

const author = {
  "@type": "Person",
  "@id": `${SITE_URL}/#person`,
  name: "Randys Machado",
  url: SITE_URL,
  image: new URL("/apple-touch-icon.png", SITE_URL).toString(),
  sameAs: SOCIAL_LINKS.map((link) => link.href).filter(Boolean),
};

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      "@id": `${SITE_URL}/#website`,
      name: SITE_TITLE,
      url: SITE_URL,
      inLanguage: "pt-BR",
      publisher: { "@id": author["@id"] },
    },
    author,
    ...(type === "article" && publishDate
      ? [
          {
            "@type": "BlogPosting",
            headline: title,
            description,
            datePublished: publishDate.toISOString(),
            dateModified: (updatedDate ?? publishDate).toISOString(),
            image: imageURL,
            url: canonicalURL,
            mainEntityOfPage: canonicalURL,
            inLanguage: "pt-BR",
            ...(section && { articleSection: section }),
            ...(tags.length > 0 && { keywords: tags.join(", ") }),
            author: { "@id": author["@id"] },
            publisher: { "@id": author["@id"] },
          },
        ]
      : []),
  ],
};
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <Font cssVariable="--font-sans" preload={[{ style: "normal" }]} />
    <Font cssVariable="--font-mono" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta
      name="theme-color"
      content="#fffcf0"
      media="(prefers-color-scheme: light)"
    />
    <meta
      name="theme-color"
      content="#100f0f"
      media="(prefers-color-scheme: dark)"
    />
    <meta name="generator" content={Astro.generator} />

    <script is:inline>
      const theme = (() => {
        if (
          typeof localStorage !== "undefined" &&
          localStorage.getItem("theme")
        ) {
          return localStorage.getItem("theme") ?? "light";
        }
        if (window.matchMedia("(prefers-color-scheme: dark)").matches) {
          return "dark";
        }
        return "light";
      })();

      if (theme === "light") {
        document.documentElement.classList.remove("dark");
      } else {
        document.documentElement.classList.add("dark");
      }

      window.localStorage.setItem("theme", theme);
    </script>

    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    {!noindex && <link rel="canonical" href={canonicalURL} />}

    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:site_name" content={SITE_TITLE} />
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:image" content={imageURL} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogImageAlt} />
    {
      type === "article" && publishDate && (
        <>
          <meta
            property="article:published_time"
            content={publishDate.toISOString()}
          />
          {updatedDate && (
            <meta
              property="article:modified_time"
              content={updatedDate.toISOString()}
            />
          )}
          <meta property="article:author" content={SITE_URL} />
          {section && <meta property="article:section" content={section} />}
          {tags.map((tag) => (
            <meta property="article:tag" content={tag} />
          ))}
        </>
      )
    }

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageURL} />
    <meta name="twitter:image:alt" content={ogImageAlt} />

    <link rel="sitemap" href="/sitemap-index.xml" />
    <link
      rel="alternate"
      type="application/rss+xml"
      title={SITE_TITLE}
      href={new URL("rss.xml", SITE_URL).toString()}
    />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} is:inline />
  </head>

  <body>
    <a href="#conteudo" class="skip-link">Pular para o conteúdo</a>
    <Header />
    <main id="conteudo" tabindex="-1" class:list={["main", classname]}>
      <slot />
    </main>
    <Footer />
  </body>
</html>

<style>
  body {
    display: flex;
    flex-direction: column;
    min-height: 100vh;
  }

  /* Visível só com foco de teclado; primeiro elemento focável da página. */
  .skip-link {
    position: absolute;
    inset-block-start: 0.75rem;
    inset-inline-start: 0.75rem;
    z-index: 100;
    padding: 0.5rem 1rem;
    border-radius: 999px;
    background: var(--text-main);
    color: var(--bg-main);
    font-size: var(--step--1);
    font-weight: 500;
    text-decoration: none;
    translate: 0 -200%;
  }

  .skip-link:focus-visible {
    translate: 0 0;
    outline: 2px solid var(--text-main);
    outline-offset: 2px;
  }

  .main:focus {
    outline: none;
  }

  .main {
    width: 100%;
    max-width: var(--content-width);
    display: flex;
    flex-grow: 1;
    flex-direction: column;
    gap: var(--space-m);
    margin-inline: auto;
    padding-inline: var(--space-s);
    padding-block: var(--space-l);
  }
</style>
