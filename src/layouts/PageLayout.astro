---
/**
 * Layout de páginas em Markdown dentro de src/pages/ (ex.: sobre.md), via o
 * campo `layout` do frontmatter. Mesmo shell das páginas de conteúdo:
 * PageHeader (título + subtítulo) e o texto em .prose.
 */
import type { MarkdownLayoutProps } from "astro";
import Layout from "@/layouts/Layout.astro";
import PageHeader from "@/components/PageHeader.astro";
import "@/styles/page-blocks.css";

type Props = MarkdownLayoutProps<{
  title: string;
  /** Descrição para buscadores e redes sociais (<meta>, Open Graph). */
  description: string;
  /** Texto exibido abaixo do título na página. */
  subtitle?: string;
}>;

const { frontmatter } = Astro.props;
---

<Layout title={frontmatter.title} description={frontmatter.description}>
  <article class="page">
    <PageHeader title={frontmatter.title} description={frontmatter.subtitle} />
    <div class="prose">
      <slot />
    </div>
  </article>
</Layout>

<style>
  .page {
    display: flex;
    flex-direction: column;
    gap: var(--space-l);
  }
</style>
