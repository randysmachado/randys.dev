---
import { NAV_LINKS } from "@/consts";

import Link from "./Link.astro";
import ThemeToggle from "./ThemeToggle.astro";
---

<header>
  <div class="header__inner">
    <Link href="/">Randys</Link>

    <nav>
      <ul>
        {
          NAV_LINKS.map(({ href, label }) => (
            <li>
              <a href={href}>{label}</a>
            </li>
          ))
        }
        <ThemeToggle />
      </ul>
    </nav>
  </div>
</header>

<style>
  header {
    position: sticky;
    top: var(--space-s);
    z-index: 50;
    max-width: var(--content-width);
    margin-inline: auto;
    padding-inline: var(--space-s);
  }

  .header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-block: var(--space-xs);
    padding-inline: var(--space-s-m);
    border-radius: 999px;
    border: 1px solid color-mix(in oklab, var(--border-main) 15%, transparent);
    background: color-mix(in oklab, var(--bg-main) 75%, transparent);
    backdrop-filter: blur(16px);
    box-shadow:
      inset 0 0 0 1px color-mix(in oklab, white 8%, transparent),
      0 1px 2px color-mix(in oklab, black 4%, transparent),
      0 8px 24px color-mix(in oklab, black 8%, transparent);
  }

  nav ul {
    display: flex;
    align-items: center;
    gap: var(--space-s-m);
  }
</style>
