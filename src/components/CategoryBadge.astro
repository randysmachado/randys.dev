---
import type { CategorySlug } from "@/consts";
import { categoryUrl, getCategory } from "@/lib/categories";

type Props = {
  slug: CategorySlug;
  /** `false` dentro de elementos que já são links (evita `<a>` aninhado). */
  linked?: boolean;
  /** `sm` para os cards da listagem. */
  size?: "md" | "sm";
};

const { slug, linked = true, size = "md" } = Astro.props;
const { label, color } = getCategory(slug);
const Tag = linked ? "a" : "span";
---

<Tag
  class:list={["category-badge", { "category-badge--sm": size === "sm" }]}
  data-category-color={color}
  href={linked ? categoryUrl(slug) : undefined}
>
  {label}
</Tag>

<style>
  .category-badge {
    display: inline-flex;
    align-items: center;
    padding: 0.125rem 0.5rem;
    border-radius: 999px;
    background: var(--cat-bg);
    color: var(--cat-fg);
    font-size: var(--step--1);
    font-weight: 500;
    line-height: 1.4;
    text-decoration: none;
    white-space: nowrap;
  }

  .category-badge--sm {
    padding: 0.0625rem 0.4375rem;
    font-size: 0.75rem;
  }

  a.category-badge:focus-visible {
    outline: 2px solid var(--cat-fg);
    outline-offset: 2px;
  }
</style>
