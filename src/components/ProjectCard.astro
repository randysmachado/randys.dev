---
import { Image } from "astro:assets";
import type { CollectionEntry } from "astro:content";

import ProjectButton from "./ProjectButton.astro";

type Props = {
  project: CollectionEntry<"projects">;
};

const { project } = Astro.props;
const { title, description, image, link } = project.data;
const url = `/projetos/${project.id}/`;
---

{
  /*
   * Cada projeto numa caixa (visual dos blocos Dev/Miscelânea da home), com o
   * layout dos cards de post. Dois links: "Ler mais" (texto) e o botão do site.
   */
}
<article class="project-card">
  <a href={url} class="project-card__cover" tabindex="-1" aria-hidden="true">
    <Image src={image} alt="" width={384} loading="lazy" />
  </a>
  <div class="project-card__body">
    <h2 class="project-card__title">
      <a href={url}>{title}</a>
    </h2>
    <p class="project-card__description">{description}</p>
    <div class="project-card__actions">
      <a href={url} class="project-card__more">
        Ler mais<span class="visually-hidden"> sobre {title}</span>
        <span aria-hidden="true">→</span>
      </a>
      <ProjectButton href={link} name={title} />
    </div>
  </div>
</article>

<style>
  .project-card {
    display: grid;
    gap: 1rem;
    padding: 1.25rem;
    border: 1px solid color-mix(in oklab, var(--text-main) 10%, transparent);
    border-radius: 1rem;
    background: color-mix(in oklab, var(--bg-main) 30%, transparent);
  }

  @media (width >= 40rem) {
    .project-card {
      grid-template-columns: 12rem minmax(0, 1fr);
      align-items: stretch;
      gap: 1.25rem;
    }
  }

  .project-card__cover {
    display: block;
    overflow: hidden;
    border-radius: min(1.2vw, 0.75rem);
    outline: 1px solid color-mix(in oklab, var(--text-main) 5%, transparent);
    outline-offset: -1px;
  }

  .project-card__cover img {
    display: block;
    width: 100%;
    height: auto;
  }

  /* Imagem ao lado do texto: acompanha a altura do card, sem sobrar vazio. */
  @media (width >= 40rem) {
    .project-card__cover img {
      height: 100%;
      object-fit: cover;
    }
  }

  .project-card__body {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    min-width: 0;
  }

  .project-card__title {
    font-size: var(--step-1);
    font-weight: 600;
    line-height: 1.3;
  }

  .project-card__title a {
    color: inherit;
    text-decoration: none;
  }

  .project-card__title a:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .project-card__description {
    color: var(--text-muted);
    text-wrap: pretty;
  }

  .project-card__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem 1rem;
    margin-block-start: 0.5rem;
  }

  /* "Ler mais": link de texto discreto; a seta desliza no hover. */
  .project-card__more {
    font-size: var(--step--1);
    font-weight: 500;
    color: var(--text-muted);
    text-decoration: none;
    transition: color 200ms ease;
  }

  .project-card__more span {
    display: inline-block;
    transition: translate 200ms ease;
  }

  .project-card__more:hover {
    color: var(--text-main);
  }

  .project-card__more:hover span {
    translate: 0.2rem 0;
  }

  :is(.project-card__title a, .project-card__more):focus-visible {
    outline: 2px solid var(--text-main);
    outline-offset: 2px;
    border-radius: 0.25rem;
  }

  @media (prefers-reduced-motion: reduce) {
    .project-card__more,
    .project-card__more span {
      transition: none;
    }
  }
</style>
