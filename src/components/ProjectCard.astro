---
import type { CollectionEntry } from "astro:content";
import Link from "@/components/Link.astro";

type Props = {
  project: CollectionEntry<"projects">;
};

const { project } = Astro.props;
const { title, description, image, link } = project.data;
---

<article class="project-card">
  {
    image && (
      <img
        class="card-cover"
        src={image.src}
        alt=""
        width={image.width}
        height={image.height}
      />
    )
  }
  <div class="card-content">
    <h3><Link href={`/projetos/${project.id}/`}>{title}</Link></h3>
    <p>{description}</p>
    <Link href={link} external underline>Ver projeto →</Link>
  </div>
</article>

<style>
  .project-card {
    position: relative;
    overflow: clip;
    display: flex;
    flex-direction: column;
    gap: var(--space-2xs);
  }

  .card-cover {
    position: absolute;
    inset: 0;
    z-index: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0.3;
    mask: linear-gradient(to right, transparent 0%, black 100%);
    transition: opacity 0.3s ease;
  }

  .project-card:hover .card-cover {
    opacity: 0.5;
  }

  .card-content {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    gap: var(--space-2xs);
  }
</style>
