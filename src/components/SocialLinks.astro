---
import { Icon } from "astro-icon/components";
import { SOCIAL_LINKS } from "@/consts";
import Link from "./Link.astro";
---

{
  SOCIAL_LINKS.map((link) => (
    <Link href={link.href} external rel="noopener noreferrer" class="social-link">
      <Icon name={link.icon} />
    </Link>
  ))
}

<style>
  :global(.social-link) {
    margin-inline: var(--space-2xs);
    color: color-mix(in oklab, var(--text-main) 70%, transparent);
  }

  :global(.social-link:hover) {
    color: var(--text-main);
  }
</style>
