---
import type { CollectionEntry } from "astro:content";
import { CATEGORIES } from "@/consts";
import Link from "@/components/Link.astro";

type Props = {
  post: CollectionEntry<"blog">;
  variant?: "default" | "preview";
};

const { post, variant = "default" } = Astro.props;
const { title, description, publishDate, categories, image, tags } = post.data;
const categoryLabels = categories
  .map((slug) => CATEGORIES.find((c) => c.slug === slug)?.label ?? slug)
  .join(", ");
---

<article
  class:list={["post-card", { "post-card--preview": variant === "preview" }]}
  data-has-image={image ? "true" : undefined}
>
  {
    variant === "preview" && (
      <a
        class="card-overlay"
        href={`/blog/${post.id}/`}
        aria-label={`Ler: ${title}`}
      />
    )
  }
  {
    image && (
      <img
        class="card-cover"
        src={image.src}
        alt=""
        width={image.width}
        height={image.height}
      />
    )
  }
  <div class="card-content">
    <p class="post-card-meta">
      {categoryLabels} · {publishDate.toLocaleDateString("pt-BR")}
    </p>
    <h3>
      {variant === "preview" ? title : <Link href={`/blog/${post.id}/`}>{title}</Link>}
    </h3>
    <p class="card-description">{description}</p>
    {
      variant === "preview" && tags && tags.length > 0 && (
        <footer class="card-tags" aria-label="Tags">
          {tags.map((tag) => (
            <span class="tag-chip">#{tag}</span>
          ))}
        </footer>
      )
    }
  </div>
</article>

<style>
  .post-card {
    position: relative;
    overflow: clip;
    display: flex;
    flex-direction: column;
    gap: var(--space-2xs);
  }

  .card-cover {
    position: absolute;
    inset: 0;
    z-index: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0.3;
    mask: linear-gradient(to right, transparent 0%, black 100%);
    transition: opacity 0.3s ease;
  }

  .post-card:hover .card-cover {
    opacity: 0.5;
  }

  .card-content {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    gap: var(--space-2xs);
    padding: var(--space-xs);
  }

  .post-card:has(.card-cover) .card-content {
    max-inline-size: 70%;
  }

  .post-card-meta {
    font-size: var(--step--1);
    color: color-mix(in oklab, var(--text-main) 60%, transparent);
  }

  .post-card--preview {
    isolation: isolate;
    width: 100%;
    min-width: 0;
    gap: 0;
    padding: var(--space-s);
    border: 1px solid transparent;
    border-radius: 0.75rem;
    background: color-mix(in oklab, var(--bg-muted) 20%, transparent);
    transition:
      background-color 0.2s ease,
      box-shadow 0.2s ease;
  }

  .post-card--preview:hover {
    background: color-mix(in oklab, var(--bg-muted) 55%, transparent);
    box-shadow: 0 0.75rem 2rem -1.25rem
      color-mix(in oklab, var(--text-main) 20%, transparent);
  }

  .card-overlay {
    position: absolute;
    inset: 0;
    z-index: 2;
    border-radius: inherit;
  }

  .card-overlay:focus-visible {
    outline: 2px solid var(--text-main);
    outline-offset: -2px;
  }

  .post-card--preview .card-cover {
    inset-block: 0;
    inset-inline: auto 0;
    width: 60%;
    height: 100%;
  }

  .post-card--preview .card-content {
    min-width: 0;
    padding: 0;
  }

  .post-card--preview[data-has-image="true"] .card-content {
    max-inline-size: 80%;
  }

  .post-card--preview h3 {
    order: 1;
    font-family: var(--font-sans);
    font-size: var(--step-1);
    font-weight: 600;
    line-height: 1.15;
    transition: color 0.2s ease;
  }

  .post-card--preview:hover h3 {
    color: color-mix(in oklab, var(--text-main) 75%, #6377ff);
  }

  .post-card--preview .card-description {
    order: 2;
    max-inline-size: 68ch;
    color: color-mix(in oklab, var(--text-main) 75%, transparent);
    font-size: var(--step--1);
    line-height: 1.55;
  }

  .post-card--preview .post-card-meta {
    order: 3;
    font-variant-numeric: tabular-nums;
  }

  .card-tags {
    position: relative;
    z-index: 3;
    order: 4;
    display: flex;
    gap: var(--space-2xs);
    overflow-x: auto;
    pointer-events: none;
    scrollbar-width: none;
  }

  .card-tags::-webkit-scrollbar {
    display: none;
  }

  .tag-chip {
    flex: none;
    padding: 0.125rem 0.5rem;
    border: 1px solid color-mix(in oklab, var(--border-main) 30%, transparent);
    border-radius: 0.375rem;
    color: color-mix(in oklab, var(--text-main) 65%, transparent);
    font-size: var(--step--1);
    line-height: 1.2;
    white-space: nowrap;
  }

  @media (width < 48rem) {
    .post-card--preview[data-has-image="true"] .card-content {
      max-inline-size: none;
      padding-block-start: 6rem;
    }

    .post-card--preview .card-cover {
      inset-block: 0 auto;
      width: 100%;
      height: 66%;
      mask: linear-gradient(to top, transparent 0%, black 100%);
    }
  }
</style>
