---
import type { CollectionEntry } from "astro:content";
import { CATEGORIES } from "@/consts";
import Link from "@/components/Link.astro";

type Props = {
  post: CollectionEntry<"blog">;
};

const { post } = Astro.props;
const { title, description, publishDate, categories, image } = post.data;
const categoryLabels = categories
  .map((slug) => CATEGORIES.find((c) => c.slug === slug)?.label ?? slug)
  .join(", ");
---

<article class="post-card">
  {
    image && (
      <img
        class="card-cover"
        src={image.src}
        alt=""
        width={image.width}
        height={image.height}
      />
    )
  }
  <div class="card-content">
    <p class="post-card-meta">
      {categoryLabels} · {publishDate.toLocaleDateString("pt-BR")}
    </p>
    <h3><Link href={`/blog/${post.id}/`}>{title}</Link></h3>
    <p>{description}</p>
  </div>
</article>

<style>
  .post-card {
    position: relative;
    overflow: clip;
    display: flex;
    flex-direction: column;
    gap: var(--space-2xs);
  }

  .card-cover {
    position: absolute;
    inset: 0;
    z-index: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0.3;
    mask: linear-gradient(to right, transparent 0%, black 100%);
    transition: opacity 0.3s ease;
  }

  .post-card:hover .card-cover {
    opacity: 0.5;
  }

  .card-content {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    gap: var(--space-2xs);
    padding: var(--space-xs);
  }

  .post-card:has(.card-cover) .card-content {
    max-inline-size: 70%;
  }

  .post-card-meta {
    font-size: var(--step--1);
    color: color-mix(in oklab, var(--text-main) 60%, transparent);
  }
</style>
