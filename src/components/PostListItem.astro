---
import { Image } from "astro:assets";
import type { CollectionEntry } from "astro:content";

type Props = {
  post: CollectionEntry<"blog">;
};

const { post } = Astro.props;
const { title, description, image } = post.data;
---

<article>
  <a
    href={`/blog/${post.id}/`}
    class:list={["post-list-item", { "post-list-item--has-image": image }]}
  >
    {
      image && (
        <div class="post-list-item__cover">
          <Image src={image} alt="" width={384} loading="lazy" />
        </div>
      )
    }
    <div class="post-list-item__body">
      <h3 class="post-list-item__title">{title}</h3>
      <p class="post-list-item__description">{description}</p>
    </div>
  </a>
</article>

<style>
  .post-list-item {
    display: grid;
    gap: 1rem;
    padding: 1rem;
    border-radius: 0.75rem;
    color: inherit;
    text-decoration: none;
    transition: background-color 200ms ease;
  }

  @media (width >= 40rem) {
    .post-list-item--has-image {
      grid-template-columns: 12rem minmax(0, 1fr);
      align-items: start;
      gap: 1.25rem;
    }
  }

  .post-list-item:hover {
    background: color-mix(in oklab, var(--bg-muted) 25%, transparent);
  }

  .post-list-item:focus-visible {
    outline: 2px solid var(--text-main);
    outline-offset: -2px;
  }

  .post-list-item__cover {
    align-self: start;
    overflow: hidden;
    border-radius: min(1.2vw, 0.75rem);
    background: color-mix(in oklab, var(--bg-muted) 20%, transparent);
    outline: 1px solid color-mix(in oklab, var(--text-main) 5%, transparent);
    outline-offset: -1px;
  }

  .post-list-item__cover img {
    display: block;
    width: 100%;
    height: auto;
  }

  .post-list-item__body {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    min-width: 0;
    padding-block: 0.125rem;
  }

  .post-list-item__title {
    font-size: var(--step-1);
    font-weight: 600;
    line-height: 1.3;
    text-wrap: balance;
  }

  .post-list-item__description {
    color: color-mix(in oklab, var(--text-main) 60%, transparent);
    text-wrap: pretty;
  }

  @media (prefers-reduced-motion: reduce) {
    .post-list-item {
      transition: none;
    }
  }
</style>
