---
import { Image } from "astro:assets";
import type { CollectionEntry } from "astro:content";

import CategoryBadge from "./CategoryBadge.astro";

type Props = {
  post: CollectionEntry<"blog">;
  /** Mostra as categorias do post acima do título (listagens de /blog). */
  showCategories?: boolean;
  /** Nível do título do card: um abaixo do título do painel. */
  headingLevel?: "h2" | "h3";
};

const { post, showCategories = false, headingLevel = "h3" } = Astro.props;
const Heading = headingLevel;
const { title, summary, description, image, categories } = post.data;
---

<article>
  <a
    href={`/blog/${post.id}/`}
    class:list={["post-list-item", { "post-list-item--has-image": image }]}
  >
    {
      image && (
        <div class="post-list-item__cover">
          <Image src={image} alt="" width={384} loading="lazy" />
        </div>
      )
    }
    <div class="post-list-item__body">
      {
        showCategories && (
          <div class="post-list-item__categories">
            {categories.map((slug) => (
              <CategoryBadge slug={slug} linked={false} size="sm" />
            ))}
          </div>
        )
      }
      <Heading class="post-list-item__title">{title}</Heading>
      <p class="post-list-item__description">{summary ?? description}</p>
    </div>
  </a>
</article>

<style>
  .post-list-item {
    display: grid;
    gap: 1rem;
    padding: 1rem;
    border-radius: 0.75rem;
    color: inherit;
    text-decoration: none;
    transition: background-color 200ms ease;
  }

  @media (width >= 40rem) {
    .post-list-item--has-image {
      grid-template-columns: 12rem minmax(0, 1fr);
      align-items: stretch;
      gap: 1.25rem;
    }
  }

  .post-list-item:hover {
    background: color-mix(in oklab, var(--bg-muted) 25%, transparent);
  }

  .post-list-item:focus-visible {
    outline: 2px solid var(--text-main);
    outline-offset: -2px;
  }

  .post-list-item__cover {
    align-self: start;
    overflow: hidden;
    border-radius: min(1.2vw, 0.75rem);
    background: color-mix(in oklab, var(--bg-muted) 20%, transparent);
    outline: 1px solid color-mix(in oklab, var(--text-main) 5%, transparent);
    outline-offset: -1px;
  }

  .post-list-item__cover img {
    display: block;
    width: 100%;
    height: auto;
  }

  /*
   * Imagem ao lado do texto: acompanha a altura do card, sem sobrar vazio
   * (mesma solução do ProjectCard). Depois da regra base de propósito.
   */
  @media (width >= 40rem) {
    .post-list-item__cover {
      align-self: stretch;
    }

    .post-list-item__cover img {
      height: 100%;
      object-fit: cover;
    }
  }

  .post-list-item__body {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    min-width: 0;
    padding-block: 0.125rem;
  }

  .post-list-item__title {
    font-size: var(--step-1);
    font-weight: 600;
    line-height: 1.3;
  }

  .post-list-item__categories {
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem;
    margin-block-end: 0.25rem;
  }

  /* No máximo duas linhas, mesmo sem `summary`. */
  .post-list-item__description {
    display: -webkit-box;
    overflow: hidden;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    line-clamp: 2;
    color: var(--text-muted);
    text-wrap: pretty;
  }

  @media (prefers-reduced-motion: reduce) {
    .post-list-item {
      transition: none;
    }
  }
</style>
