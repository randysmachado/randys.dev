---
import { NAV_LINKS } from "@/consts";
import { isActive } from "@/lib/nav";

type Props = {
  pathname: string;
};

const { pathname } = Astro.props;
---

<div class="mobile-menu-root">
  <button
    type="button"
    class="menu-toggle"
    popovertarget="mobile-menu"
    aria-label="Abrir menu"
  >
    <span class="menu-toggle__bar" aria-hidden="true"></span>
    <span class="menu-toggle__bar" aria-hidden="true"></span>
    <span class="menu-toggle__bar" aria-hidden="true"></span>
  </button>

  <nav
    id="mobile-menu"
    class="mobile-menu paper-glass"
    popover
    aria-label="Menu principal"
  >
    {
      NAV_LINKS.map(({ href, label }) => (
        <a
          href={href}
          class="mobile-menu__link"
          aria-current={isActive(href, pathname) ? "page" : undefined}
        >
          {label}
        </a>
      ))
    }
  </nav>
</div>

<style>
  .mobile-menu-root {
    display: flex;
  }

  @media (width >= 48rem) {
    .mobile-menu-root {
      display: none;
    }
  }

  .menu-toggle {
    position: relative;
    display: grid;
    place-items: center;
    inline-size: 2.75rem;
    block-size: 2.75rem;
    padding: 0;
    border: none;
    border-radius: 0.75rem;
    background: none;
    color: inherit;
    cursor: pointer;
  }

  .menu-toggle:focus-visible {
    outline: 2px solid var(--text-main);
    outline-offset: 2px;
  }

  .menu-toggle__bar {
    position: absolute;
    inset-inline-start: 50%;
    inline-size: 1.25rem;
    block-size: 2px;
    margin-inline-start: -0.625rem;
    border-radius: 1px;
    background: currentColor;
    transition:
      transform 300ms ease,
      opacity 200ms ease;
  }

  .menu-toggle__bar:nth-child(1) {
    top: calc(50% - 7px);
  }

  .menu-toggle__bar:nth-child(2) {
    top: calc(50% - 1px);
  }

  .menu-toggle__bar:nth-child(3) {
    top: calc(50% + 5px);
  }

  /* Barras viram "X" enquanto o painel está aberto. */
  .mobile-menu-root:has(.mobile-menu:popover-open) .menu-toggle__bar:nth-child(1) {
    transform: translateY(6px) rotate(45deg);
  }

  .mobile-menu-root:has(.mobile-menu:popover-open) .menu-toggle__bar:nth-child(2) {
    opacity: 0;
  }

  .mobile-menu-root:has(.mobile-menu:popover-open) .menu-toggle__bar:nth-child(3) {
    transform: translateY(-6px) rotate(-45deg);
  }

  /*
   * O popover fica no top layer, então escapa do containing block criado
   * pelo `backdrop-filter` do header. Reset dos estilos padrão do UA.
   */
  .mobile-menu {
    position: fixed;
    inset: 5rem var(--space-s) auto;
    inline-size: auto;
    margin: 0;
    padding: 0.5rem;
    border-radius: 1rem;
    color: var(--text-main);
    flex-direction: column;
    gap: 0.25rem;
    opacity: 0;
    transform: translateY(-0.5rem) scale(0.98);
    transform-origin: top;
    transition:
      opacity 300ms ease-out,
      transform 300ms ease-out,
      overlay 300ms ease-out allow-discrete,
      display 300ms ease-out allow-discrete;
  }

  .mobile-menu:popover-open {
    display: flex;
    opacity: 1;
    transform: none;
  }

  @starting-style {
    .mobile-menu:popover-open {
      opacity: 0;
      transform: translateY(-0.5rem) scale(0.98);
    }
  }

  .mobile-menu__link {
    padding: 0.75rem;
    border-radius: 0.75rem;
    color: color-mix(in oklab, var(--text-main) 60%, transparent);
    font-weight: 500;
    text-decoration: none;
  }

  .mobile-menu__link:hover,
  .mobile-menu__link[aria-current="page"] {
    color: var(--text-main);
  }

  .mobile-menu__link[aria-current="page"] {
    background: color-mix(in oklab, var(--bg-muted) 60%, transparent);
  }

  .mobile-menu__link:focus-visible {
    outline: 2px solid var(--text-main);
    outline-offset: -2px;
  }

  @media (prefers-reduced-motion: reduce) {
    .menu-toggle__bar,
    .mobile-menu {
      transition: none;
    }
  }
</style>
