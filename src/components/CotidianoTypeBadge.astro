---
import type { CotidianoType } from "@/consts";
import { getCotidianoType } from "@/lib/cotidiano";

type Props = { type: CotidianoType };

const { type } = Astro.props;
const { label } = getCotidianoType(type);
---

<span class="cotidiano-type" data-type={type}>{label}</span>

<style>
  /*
   * Rótulo do tipo, com cores da paleta Flexoki. Claro: fundo no tom 50 e texto
   * no 700. Escuro: fundo no tom 600 e texto branco. Ver planejamento/0046.
   */
  .cotidiano-type {
    display: inline-flex;
    justify-content: center;
    min-inline-size: 5.75rem;
    padding: 0.0625rem 0.4375rem;
    border-radius: 0.375rem;
    background: var(--cat-bg);
    color: var(--cat-fg);
    font-size: 0.75rem;
    font-weight: 500;
    line-height: 1.5;
    white-space: nowrap;
  }

  /*
   * No escuro, o fundo é o tom 600 (mais claro e vivo que o 950) e o texto é
   * branco: contraste AA em todos os tipos (ciano e verde ficam perto de 4.5).
   */
  .cotidiano-type[data-type="livro"] {
    --cat-bg: light-dark(#e1eceb, #205ea6);
    --cat-fg: light-dark(#1a4f8c, #ffffff);
  }

  .cotidiano-type[data-type="artigo"] {
    --cat-bg: light-dark(#ddf1e4, #24837b);
    --cat-fg: light-dark(#1c6c66, #ffffff);
  }

  .cotidiano-type[data-type="serie"] {
    --cat-bg: light-dark(#f0eaec, #5e409d);
    --cat-fg: light-dark(#4f3685, #ffffff);
  }

  .cotidiano-type[data-type="filme"] {
    --cat-bg: light-dark(#edeecf, #66800b);
    --cat-fg: light-dark(#536907, #ffffff);
  }

  .cotidiano-type[data-type="anime"] {
    --cat-bg: light-dark(#fee4e5, #a02f6f);
    --cat-fg: light-dark(#87285e, #ffffff);
  }

  .cotidiano-type[data-type="documentario"] {
    --cat-bg: light-dark(#ffe7ce, #bc5215);
    --cat-fg: light-dark(#9d4310, #ffffff);
  }
</style>
