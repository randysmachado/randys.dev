---
import type { CotidianoType } from "@/consts";
import { getCotidianoType } from "@/lib/cotidiano";

type Props = { type: CotidianoType };

const { label, color } = getCotidianoType(Astro.props.type);
---

<span class="cotidiano-type" data-category-color={color}>{label}</span>

<style>
  /* Rótulo do tipo: cores das categorias (categories.css). */
  .cotidiano-type {
    display: inline-flex;
    justify-content: center;
    min-inline-size: 5.75rem;
    padding: 0.0625rem 0.4375rem;
    border-radius: 0.375rem;
    background: var(--cat-bg);
    color: var(--cat-fg);
    font-size: 0.75rem;
    font-weight: 500;
    line-height: 1.5;
    white-space: nowrap;
  }
</style>
