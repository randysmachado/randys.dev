---
import type { CotidianoType } from "@/consts";
import { getCotidianoType } from "@/lib/cotidiano";

type Props = { type: CotidianoType };

const { type } = Astro.props;
const { label } = getCotidianoType(type);
---

<span class="cotidiano-type" data-type={type}>{label}</span>

<style>
  /*
   * Rótulo do tipo, na paleta Flexoki (ver planejamento/0053). Claro: fundo no
   * tom 50 e texto no 700. Escuro: fundo no tom 950 tingido e texto no 300.
   */
  .cotidiano-type {
    display: inline-flex;
    justify-content: center;
    min-inline-size: 4.5rem;
    padding: 0 0.375rem;
    border-radius: 0.375rem;
    background: var(--cat-bg);
    color: var(--cat-fg);
    font-size: 0.75rem;
    font-weight: 500;
    line-height: 1.5;
    white-space: nowrap;
  }

  .cotidiano-type[data-type="livro"] {
    --cat-bg: light-dark(#e1eceb, color-mix(in oklab, #101a24 35%, var(--bg-main)));
    --cat-fg: light-dark(#1a4f8c, #66a0c8);
  }

  .cotidiano-type[data-type="artigo"] {
    --cat-bg: light-dark(#ddf1e4, color-mix(in oklab, #101f1d 35%, var(--bg-main)));
    --cat-fg: light-dark(#1c6c66, #5abdac);
  }

  .cotidiano-type[data-type="serie"] {
    --cat-bg: light-dark(#f0eaec, color-mix(in oklab, #1a1623 35%, var(--bg-main)));
    --cat-fg: light-dark(#4f3685, #a699d0);
  }

  .cotidiano-type[data-type="filme"] {
    --cat-bg: light-dark(#ffe1d5, color-mix(in oklab, #261312 35%, var(--bg-main)));
    --cat-fg: light-dark(#942822, #e8705f);
  }

  .cotidiano-type[data-type="anime"] {
    --cat-bg: light-dark(#fee4e5, color-mix(in oklab, #24131d 35%, var(--bg-main)));
    --cat-fg: light-dark(#87285e, #e47da8);
  }

  .cotidiano-type[data-type="documentario"] {
    --cat-bg: light-dark(#ffe7ce, color-mix(in oklab, #27180e 35%, var(--bg-main)));
    --cat-fg: light-dark(#9d4310, #ec8b49);
  }
</style>
