---
import { cn } from "@/lib/utils";

type Props = {
  href: string;
  label?: string;
  external?: boolean;
  underline?: boolean;
  class?: string;
  [key: string]: any;
};

const {
  href,
  label,
  external,
  underline,
  class: classes,
  ...rest
} = Astro.props;
---

<a
  href={href}
  target={external ? "_blank" : "_self"}
  class={cn(
    "no-underline inline-flex transition-colors duration-300 ease-in-out",
    underline &&
      "underline decoration-muted-foreground underline-offset-[3px] hover:decoration-foreground",
    classes,
  )}
  {...rest}
>
  <slot />
</a>
