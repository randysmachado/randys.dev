---
type Props = {
  href: string;
  external?: boolean;
  underline?: boolean;
  class?: string;
  [key: string]: any;
};

const { href, external, underline, class: classes, ...rest } = Astro.props;
---

<a
  href={href}
  target={external ? "_blank" : "_self"}
  class:list={["link", { "link--underline": underline }, classes]}
  {...rest}
>
  <slot />
</a>

<style>
  .link {
    display: inline-flex;
    text-decoration: none;
    color: inherit;
    transition: color 0.3s ease-in-out;
  }

  .link--underline {
    text-decoration: underline;
    text-decoration-color: color-mix(in oklab, var(--text-main) 60%, transparent);
    text-underline-offset: 3px;
  }

  .link--underline:hover {
    text-decoration-color: var(--text-main);
  }
</style>
