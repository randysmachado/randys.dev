---
import { COTIDIANO_TYPES } from "@/consts";
import type { CotidianoMonth } from "@/lib/cotidiano";
import CotidianoTypeBadge from "./CotidianoTypeBadge.astro";
import CotidianoEntry from "./CotidianoEntry.astro";

type Props = {
  year: number;
  months: CotidianoMonth[];
};

const { year, months } = Astro.props;
const items = months.flatMap((month) => month.items);

// Filtro: só os tipos que aparecem neste ano, com contador.
const counts = COTIDIANO_TYPES.map((type) => ({
  ...type,
  count: items.filter((item) => item.data.type === type.slug).length,
})).filter((type) => type.count > 0);

/*
 * Filtro sem JavaScript: cada rádio marcado esconde, via :has(), os itens de
 * outros tipos e os meses sem nenhum item do tipo escolhido. Sem suporte a
 * :has(), a lista aparece inteira.
 */
const filterCss = counts
  .map(
    ({ slug }) => `
.cotidiano-history:has(#filtro-${slug}:checked) .cotidiano-history__item:not([data-type="${slug}"]),
.cotidiano-history:has(#filtro-${slug}:checked) .cotidiano-history__month:not(:has([data-type="${slug}"])) { display: none; }`,
  )
  .join("");
---

<section class="cotidiano-history" aria-labelledby="cotidiano-ano">
  <h2 id="cotidiano-ano" class="cotidiano-history__year">{year}</h2>

  {
    items.length === 0 ? (
      <p class="cotidiano-history__empty">
        Nada concluído em {year} ainda.
      </p>
    ) : (
      <>
        {counts.length > 1 && (
          <fieldset class="cotidiano-filter">
            <legend class="visually-hidden">Filtrar por tipo</legend>
            <input
              type="radio"
              name="cotidiano-filtro"
              id="filtro-todos"
              class="visually-hidden"
              checked
            />
            <label for="filtro-todos">
              Todos <span>{items.length}</span>
            </label>
            {counts.map(({ slug, plural, count }) => (
              <>
                <input
                  type="radio"
                  name="cotidiano-filtro"
                  id={`filtro-${slug}`}
                  class="visually-hidden"
                />
                <label for={`filtro-${slug}`}>
                  {plural} <span>{count}</span>
                </label>
              </>
            ))}
          </fieldset>
        )}

        {months.map((month) => (
          <section class="cotidiano-history__month" aria-labelledby={`mes-${month.key}`}>
            <h3 id={`mes-${month.key}`} class="cotidiano-history__month-title">
              {month.label}
            </h3>
            <ul class="cotidiano-history__list" role="list">
              {month.items.map((item) => (
                <li class="cotidiano-history__item" data-type={item.data.type}>
                  <CotidianoTypeBadge type={item.data.type} />
                  <CotidianoEntry item={item} />
                </li>
              ))}
            </ul>
          </section>
        ))}
      </>
    )
  }
</section>

<Fragment set:html={`<style>${filterCss}</style>`} />

<style>
  .cotidiano-history {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .cotidiano-history__year {
    font-size: var(--step-2);
    font-weight: 600;
  }

  .cotidiano-history__empty {
    color: var(--text-muted);
  }

  .cotidiano-filter {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 0;
    padding: 0;
    border: 0;
  }

  .cotidiano-filter label {
    display: inline-flex;
    gap: 0.375rem;
    padding: 0.375rem 0.875rem;
    border-radius: 999px;
    color: var(--text-muted);
    font-size: var(--step--1);
    font-weight: 500;
    cursor: pointer;
    transition:
      background-color 200ms ease,
      color 200ms ease;
  }

  .cotidiano-filter label span {
    opacity: 0.7;
    font-variant-numeric: tabular-nums;
  }

  .cotidiano-filter label:hover {
    color: var(--text-main);
  }

  .cotidiano-filter input:checked + label {
    background: var(--bg-muted);
    color: var(--text-main);
  }

  .cotidiano-filter input:focus-visible + label {
    outline: 2px solid var(--text-main);
    outline-offset: 2px;
  }

  .cotidiano-history__month {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .cotidiano-history__month-title {
    font-size: var(--step--1);
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-muted);
  }

  .cotidiano-history__list {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .cotidiano-history__item {
    display: flex;
    align-items: baseline;
    gap: 0.625rem;
  }

  @media (prefers-reduced-motion: reduce) {
    .cotidiano-filter label {
      transition: none;
    }
  }
</style>
