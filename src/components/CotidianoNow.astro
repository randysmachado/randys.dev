---
import type { CotidianoItem } from "@/lib/cotidiano";
import { getCotidianoType } from "@/lib/cotidiano";
import CotidianoTypeBadge from "./CotidianoTypeBadge.astro";
import CotidianoEntry from "./CotidianoEntry.astro";

type Props = { items: CotidianoItem[] };

const { items } = Astro.props;
---

{
  items.length > 0 && (
    <section class="cotidiano-now" aria-labelledby="cotidiano-agora">
      <h2 id="cotidiano-agora" class="cotidiano-now__title">
        Atualmente
      </h2>
      <ul class="cotidiano-now__list" role="list">
        {items.map((item) => (
          <li class="cotidiano-now__item">
            <span class="cotidiano-now__flag">
              {getCotidianoType(item.data.type).verb}
            </span>
            <CotidianoTypeBadge type={item.data.type} />
            <CotidianoEntry item={item} />
          </li>
        ))}
      </ul>
    </section>
  )
}

<style>
  /* Destaque do que está em andamento: caixa como os painéis da home. */
  .cotidiano-now {
    padding: 1rem 1.25rem;
    border: 1px solid color-mix(in oklab, var(--text-main) 10%, transparent);
    border-radius: 1rem;
    background: color-mix(in oklab, var(--bg-main) 30%, transparent);
  }

  .cotidiano-now__title {
    margin-block-end: 0.75rem;
    font-size: var(--step--1);
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-muted);
  }

  .cotidiano-now__list {
    display: flex;
    flex-direction: column;
    gap: 0.625rem;
  }

  .cotidiano-now__item {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.375rem 0.625rem;
  }

  /* Flag "assistindo/lendo" com um pontinho pulsando, como um "ao vivo". */
  .cotidiano-now__flag {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    min-inline-size: 6.5rem;
    font-size: var(--step--1);
    font-weight: 600;
    color: var(--text-main);
  }

  .cotidiano-now__flag::before {
    content: "";
    inline-size: 0.5rem;
    block-size: 0.5rem;
    border-radius: 50%;
    background: light-dark(#66800b, #879a39);
    box-shadow: 0 0 0 0
      color-mix(in oklab, light-dark(#66800b, #879a39) 50%, transparent);
    animation: cotidiano-pulse 2s ease-out infinite;
  }

  @keyframes cotidiano-pulse {
    70% {
      box-shadow: 0 0 0 0.375rem transparent;
    }
    100% {
      box-shadow: 0 0 0 0 transparent;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .cotidiano-now__flag::before {
      animation: none;
    }
  }
</style>
