---
import type { CollectionEntry } from "astro:content";
import { Icon } from "astro-icon/components";

import PostListItem from "./PostListItem.astro";

type Props = {
  title: string;
  /** `h1` quando o painel é o conteúdo principal da página (ex.: /blog). */
  headingLevel?: "h1" | "h2";
  posts: CollectionEntry<"blog">[];
  /** Link opcional no cabeçalho (ex.: "3 de 5 posts ›"). */
  more?: { href: string; label: string };
};

const { title, headingLevel = "h2", posts, more } = Astro.props;
const Heading = headingLevel;
const headingId = `posts-panel-${title.toLowerCase()}`;
---

<section class="posts-panel" aria-labelledby={headingId}>
  <header class="posts-panel__header">
    <Heading id={headingId} class="posts-panel__title">{title}</Heading>
    {
      more && (
        <a href={more.href} class="posts-panel__more">
          <span>{more.label}</span>
          <Icon name="chevron-right" class="posts-panel__chevron" aria-hidden="true" />
        </a>
      )
    }
  </header>
  <ul class="posts-panel__list" role="list">
    {
      posts.map((post) => (
        <li>
          <PostListItem post={post} />
        </li>
      ))
    }
  </ul>
</section>

<style>
  .posts-panel {
    overflow: hidden;
    border: 1px solid color-mix(in oklab, var(--text-main) 10%, transparent);
    border-radius: 1rem;
    background: color-mix(in oklab, var(--bg-main) 30%, transparent);
  }

  .posts-panel__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 1rem 1rem 0.5rem;
  }

  @media (width >= 40rem) {
    .posts-panel__header {
      padding: 1.25rem 1.25rem 0.5rem;
    }
  }

  .posts-panel__title {
    font-size: var(--step-2);
    font-weight: 600;
  }

  .posts-panel__more {
    display: flex;
    flex-shrink: 0;
    align-items: center;
    gap: 0.375rem;
    border-radius: 0.5rem;
    font-size: var(--step--1);
    font-weight: 500;
    color: color-mix(in oklab, var(--text-main) 60%, transparent);
    text-decoration: none;
    transition: color 200ms ease;
  }

  .posts-panel__more:hover {
    color: var(--text-main);
  }

  .posts-panel__more:focus-visible {
    outline: 2px solid var(--text-main);
    outline-offset: 2px;
  }

  .posts-panel__chevron {
    inline-size: 1rem;
    block-size: 1rem;
    transition: transform 200ms ease;
  }

  .posts-panel__more:hover .posts-panel__chevron {
    transform: translateX(0.125rem);
  }

  .posts-panel__list {
    display: flex;
    flex-direction: column;
    padding: 0 0.25rem 0.25rem;
  }

  @media (prefers-reduced-motion: reduce) {
    .posts-panel__more,
    .posts-panel__chevron {
      transition: none;
    }
  }
</style>
