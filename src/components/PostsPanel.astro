---
import type { CollectionEntry } from "astro:content";
import { Icon } from "astro-icon/components";

import PostListItem from "./PostListItem.astro";

type Props = {
  title: string;
  /** Descrição curta exibida ao lado do título. */
  description?: string;
  /** `h1` quando o painel é o conteúdo principal da página (ex.: /blog). */
  headingLevel?: "h1" | "h2";
  posts: CollectionEntry<"blog">[];
  showCategories?: boolean;
  /** Link opcional no cabeçalho (ex.: "3 de 5 posts ›"). */
  more?: { href: string; label: string };
};

const {
  title,
  description,
  headingLevel = "h2",
  posts,
  showCategories = false,
  more,
} = Astro.props;
const Heading = headingLevel;
const headingId = `posts-panel-${title
  .normalize("NFD")
  .replace(/[\u0300-\u036f]/g, "")
  .toLowerCase()
  .replace(/\s+/g, "-")}`;
---

<section class="posts-panel" aria-labelledby={headingId}>
  <header class="posts-panel__header">
    <div class="posts-panel__heading">
      <Heading id={headingId} class="posts-panel__title">{title}</Heading>
      {description && <p class="posts-panel__description">{description}</p>}
    </div>
    {
      more && (
        <a href={more.href} class="posts-panel__more">
          <span>{more.label}</span>
          <Icon
            name="chevron-right"
            class="posts-panel__chevron"
            aria-hidden="true"
          />
        </a>
      )
    }
  </header>
  <ul class="posts-panel__list" role="list">
    {
      posts.map((post) => (
        <li>
          <PostListItem post={post} showCategories={showCategories} />
        </li>
      ))
    }
  </ul>
</section>

<style>
  .posts-panel {
    overflow: hidden;
    border: 1px solid color-mix(in oklab, var(--text-main) 10%, transparent);
    border-radius: 1rem;
    background: color-mix(in oklab, var(--bg-main) 30%, transparent);
  }

  .posts-panel__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 1rem 1rem 0.5rem;
  }

  @media (width >= 40rem) {
    .posts-panel__header {
      padding: 1.25rem 1.25rem 0.5rem;
    }
  }

  .posts-panel__heading {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.25rem 0.625rem;
    min-width: 0;
  }

  .posts-panel__description {
    color: var(--text-muted);
    font-size: var(--step--1);
  }

  .posts-panel__title {
    font-size: var(--step-2);
    font-weight: 600;
  }

  .posts-panel__more {
    display: flex;
    flex-shrink: 0;
    align-items: center;
    gap: 0.375rem;
    border-radius: 0.5rem;
    font-size: var(--step--1);
    font-weight: 500;
    color: var(--text-muted);
    text-decoration: none;
    transition: color 200ms ease;
  }

  .posts-panel__more:hover {
    color: var(--text-main);
  }

  .posts-panel__more:focus-visible {
    outline: 2px solid var(--text-main);
    outline-offset: 2px;
  }

  .posts-panel__chevron {
    inline-size: 1rem;
    block-size: 1rem;
    transition: transform 200ms ease;
  }

  .posts-panel__more:hover .posts-panel__chevron {
    transform: translateX(0.125rem);
  }

  .posts-panel__list {
    display: flex;
    flex-direction: column;
    padding: 0 0.25rem 0.25rem;
  }

  /* Divisor sutil entre os cards, alinhado ao padding interno deles. */
  .posts-panel__list > li + li::before {
    content: "";
    display: block;
    block-size: 1px;
    margin-inline: 1rem;
    background: var(--border-main);
  }

  @media (prefers-reduced-motion: reduce) {
    .posts-panel__more,
    .posts-panel__chevron {
      transition: none;
    }
  }
</style>
