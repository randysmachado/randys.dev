---
import { getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Link from "@/components/Link.astro";
import { HOME_POSTS_PER_CATEGORY, type CategorySlug } from "@/consts";
import HomePostsSection from "@/components/HomePostsSection.astro";
import ProjectCard from "@/components/ProjectCard.astro";

const allPosts = await getCollection("blog");
const allProjects = await getCollection("projects");

const byRecent = (
  a: (typeof allPosts)[number],
  b: (typeof allPosts)[number],
) => b.data.publishDate.getTime() - a.data.publishDate.getTime();

const postsIn = (category: CategorySlug) =>
  allPosts
    .filter((post) => post.data.categories.includes(category))
    .sort(byRecent);

const devPosts = postsIn("dev");
const blogPosts = postsIn("blog");

const featuredProjects = allProjects
  .filter((project) => project.data.featured)
  .sort(
    (a, b) => b.data.publishDate.getTime() - a.data.publishDate.getTime(),
  );
---

<Layout>
  <section class="intro">
    <h1 class="intro__title">Oi, eu sou o Randys.</h1>
    <div class="intro__text">
      <p>
        Sou desenvolvedor e gosto de construir coisas úteis para a web. Aqui
        escrevo sobre o que aprendo no dia a dia com código, arquitetura e
        ferramentas.
      </p>
      <p class="intro__muted">
        Este é o meu cantinho na internet — um espaço para falar de
        tecnologia, mas também de viagens, férias e do que mais passar pela
        cabeça.
      </p>
    </div>
  </section>

  {
    devPosts.length > 0 && (
      <HomePostsSection
        title="Dev"
        posts={devPosts.slice(0, HOME_POSTS_PER_CATEGORY)}
        total={devPosts.length}
        href="/blog"
      />
    )
  }

  {
    blogPosts.length > 0 && (
      <HomePostsSection
        title="Blog"
        posts={blogPosts.slice(0, HOME_POSTS_PER_CATEGORY)}
        total={blogPosts.length}
        href="/blog"
      />
    )
  }

  {
    featuredProjects.length > 0 && (
      <section>
        <h2>Projetos</h2>
        <div class="project-grid">
          {featuredProjects.map((project) => (
            <ProjectCard project={project} />
          ))}
        </div>
        <Link href="/projetos" underline>Ver todos os projetos →</Link>
      </section>
    )
  }
</Layout>

<style>
  .intro {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    padding-block: var(--space-m) 0.5rem;
  }

  .intro__title {
    max-width: 20ch;
    font-family: var(--font-sans);
    font-size: var(--step-5);
    font-weight: 600;
    letter-spacing: -0.025em;
    line-height: 1.1;
    text-wrap: balance;
  }

  .intro__text {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    font-size: var(--step-1);
    text-wrap: pretty;
  }

  .intro__muted {
    color: color-mix(in oklab, var(--text-main) 60%, transparent);
  }

  .project-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(16rem, 1fr));
    gap: var(--space-m);
  }
</style>
