---
import { getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import { HOME_POSTS_COUNT } from "@/consts";
import PostsPanel from "@/components/PostsPanel.astro";
import { isPublished } from "@/lib/published";

/** Os mais recentes, de qualquer categoria (mesma ordem de /blog). */
const latestPosts = (await getCollection("blog", isPublished))
  .sort((a, b) => b.data.publishDate.getTime() - a.data.publishDate.getTime())
  .slice(0, HOME_POSTS_COUNT);
---

<Layout>
  <section class="intro">
    <h1 class="intro__title">Oi, eu sou o Randys.</h1>
    <div class="intro__text">
      <p>
        Sou Engenheiro de Software e CTO na EverestHub. Atualmente estou focando
        no desenvolvimento de produtos, sites, SaaS e soluções web.
      </p>
      <p class="intro__muted">
        Neste pequeno espaço na internet escrevo sobre tecnologia,
        desenvolvimento, experiências e o que mais passar pela cabeça.
      </p>
    </div>
  </section>

  {
    latestPosts.length > 0 && (
      <section class="home-latest">
        <PostsPanel
          title="Últimos posts"
          description="os mais recentes, de qualquer categoria"
          posts={latestPosts}
          showCategories
        />
        <a class="home-latest__all" href="/blog/">
          Ver todos os posts
          <span aria-hidden="true">→</span>
        </a>
      </section>
    )
  }
</Layout>

<style>
  .intro {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    padding-block: var(--space-m) 0.5rem;
  }

  .intro__title {
    max-width: 20ch;
    font-family: var(--font-sans);
    font-size: var(--step-5);
    font-weight: 600;
    letter-spacing: -0.025em;
    line-height: 1.1;
    text-wrap: balance;
  }

  .intro__text {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    font-size: var(--step-0);
    text-wrap: pretty;
  }

  .intro__muted {
    color: var(--text-muted);
  }

  .home-latest {
    display: flex;
    flex-direction: column;
    gap: var(--space-s);
  }

  /* Botão para o blog: contorno e fundo do site, sem competir com os cards. */
  .home-latest__all {
    align-self: flex-start;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.5rem 1rem;
    border: 1px solid var(--border-main);
    border-radius: 999px;
    background: var(--bg-main);
    color: var(--text-main);
    font-size: var(--step--1);
    font-weight: 500;
    text-decoration: none;
    transition: background-color 200ms ease;
  }

  .home-latest__all:hover {
    background: var(--bg-muted);
  }

  .home-latest__all:focus-visible {
    outline: 2px solid var(--text-main);
    outline-offset: 2px;
  }

  @media (prefers-reduced-motion: reduce) {
    .home-latest__all {
      transition: none;
    }
  }
</style>
