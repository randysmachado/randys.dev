---
import { Image } from "astro:assets";
import { getCollection, render } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import TableOfContents from "@/components/TableOfContents.astro";
import CategoryBadge from "@/components/CategoryBadge.astro";
import PageHeader from "@/components/PageHeader.astro";
import { formatDate } from "@/lib/date";
import { tagUrl } from "@/lib/tags";
import { getCategory } from "@/lib/categories";

export async function getStaticPaths() {
  const posts = await getCollection("blog");
  return posts.map((post) => ({
    params: { id: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content, headings } = await render(post);
const {
  title,
  description,
  publishDate,
  updatedDate,
  categories,
  tags,
  image,
  imageAlt,
} = post.data;
---

<Layout
  title={title}
  description={description}
  image={image}
  imageAlt={imageAlt}
  type="article"
  publishDate={publishDate}
  updatedDate={updatedDate}
  section={getCategory(categories[0]).label}
  tags={tags}
>
  <article class="post">
    <PageHeader title={title} description={description}>
      <div class="post-meta">
        <span class="post-categories">
          {categories.map((slug) => <CategoryBadge slug={slug} />)}
        </span>
        <span class="post-date-tags">
          <time datetime={publishDate.toISOString().slice(0, 10)}>
            {formatDate(publishDate)}
          </time>
          {
            updatedDate && (
              <span class="post-updated">
                &nbsp;· atualizado em{" "}
                <time datetime={updatedDate.toISOString().slice(0, 10)}>
                  {formatDate(updatedDate)}
                </time>
              </span>
            )
          }
          {
            tags && tags.length > 0 && (
              <>
                <span aria-hidden="true">&nbsp;· </span>
                <ul class="post-tags" role="list" aria-label="Tags">
                  {tags.map((tag) => (
                    <li>
                      <a href={tagUrl(tag)} class="post-tag" rel="tag">
                        #{tag}
                      </a>
                    </li>
                  ))}
                </ul>
              </>
            )
          }
        </span>
      </div>
    </PageHeader>
    {
      image && (
        <Image
          src={image}
          alt={imageAlt ?? ""}
          layout="constrained"
          width={768}
          priority
          class="post-cover"
        />
      )
    }
    <div class="post-content prose">
      <Content />
    </div>
  </article>
  <TableOfContents headings={headings} />
</Layout>

<style>
  .post {
    display: flex;
    flex-direction: column;
    gap: var(--space-l);
  }

  .post-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 0.75rem;
    font-size: var(--step--1);
    color: var(--text-muted);
  }

  /* Capa: proporção original, cantos e contorno como os dos cards. */
  .post-cover {
    display: block;
    inline-size: 100%;
    block-size: auto;
    border-radius: 0.75rem;
    outline: 1px solid color-mix(in oklab, var(--text-main) 5%, transparent);
    outline-offset: -1px;
  }

  /*
   * Data · tags como texto corrido: se quebrar linha, quebra entre as tags e
   * o "·" fica sempre colado à data (&nbsp;), nunca no começo da linha.
   */
  .post-tags,
  .post-tags li {
    display: inline;
  }

  .post-tags li + li {
    margin-inline-start: 0.5rem;
  }

  .post-tag {
    color: var(--text-muted);
    text-decoration: none;
    text-underline-offset: 3px;
  }

  .post-tag:hover {
    color: var(--text-main);
    text-decoration: underline;
  }

  .post-tag:focus-visible {
    outline: 2px solid var(--text-main);
    outline-offset: 2px;
    border-radius: 0.25rem;
  }

  .post-categories {
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem;
  }
</style>
