---
import { getCollection, render } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import TableOfContents from "@/components/TableOfContents.astro";
import CategoryBadge from "@/components/CategoryBadge.astro";

export async function getStaticPaths() {
  const posts = await getCollection("blog");
  return posts.map((post) => ({
    params: { id: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content, headings } = await render(post);
const { title, description, publishDate, categories, tags, image } =
  post.data;
---

<Layout
  title={title}
  description={description}
  image={image?.src}
  type="article"
  publishDate={publishDate}
>
  <article class="post">
    <header class="post-header">
      <h1>{title}</h1>
      <div class="post-meta">
        <span class="post-categories">
          {categories.map((slug) => <CategoryBadge slug={slug} />)}
        </span>
        <time datetime={publishDate.toISOString()}>
          {publishDate.toLocaleDateString("pt-BR")}
        </time>
      </div>
    </header>
    <div class="post-content">
      <Content />
      {
        tags && tags.length > 0 && (
          <p class="tags">{tags.map((tag) => `#${tag}`).join(" ")}</p>
        )
      }
    </div>
  </article>
  <TableOfContents headings={headings} />
</Layout>

<style>
  .post {
    display: flex;
    flex-direction: column;
    gap: var(--space-l);
  }

  .post-header {
    display: flex;
    flex-direction: column;
    gap: var(--space-2xs);
    padding-block-end: var(--space-m);
    border-bottom: 1px solid var(--border-main);
  }

  .post-header h1 {
    font-size: clamp(2rem, 1.6296rem + 1.8079vw, 3rem);
  }

  .post-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 0.75rem;
    font-size: var(--step--1);
    color: var(--text-muted);
  }

  .post-categories {
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem;
  }

  .post-content {
    display: flex;
    flex-direction: column;
    gap: var(--space-s);
  }

  .tags {
    font-size: var(--step--1);
    color: var(--text-muted);
  }

  .post-content :global(h2),
  .post-content :global(h3),
  .post-content :global(h4),
  .post-content :global(h5),
  .post-content :global(h6) {
    position: relative;
    margin-block-start: var(--space-m);
  }

  .post-content :global(h2) {
    font-size: clamp(1.625rem, 1.393rem + 1.13vw, 2.25rem);
  }

  .post-content :global(h3) {
    font-size: clamp(1.375rem, 1.236rem + 0.68vw, 1.75rem);
  }

  .post-content :global(h4) {
    font-size: clamp(1.1875rem, 1.118rem + 0.34vw, 1.375rem);
  }

  .post-content :global([data-heading-anchor]) {
    position: absolute;
    inset-inline-start: -1.1em;
    display: inline-flex;
    align-items: center;
    inline-size: 1em;
    block-size: 1em;
    color: var(--text-faint);
    text-decoration: none;
    opacity: 0;
    transition: opacity 0.15s ease;
  }

  .post-content :global([data-heading-anchor])::before {
    content: "#";
  }

  .post-content :global(h2:hover [data-heading-anchor]),
  .post-content :global(h3:hover [data-heading-anchor]),
  .post-content :global(h4:hover [data-heading-anchor]),
  .post-content :global(h5:hover [data-heading-anchor]),
  .post-content :global(h6:hover [data-heading-anchor]) {
    opacity: 1;
  }

  .post-content :global([data-heading-anchor]:hover) {
    color: var(--text-main);
  }
</style>
