---
import { getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import PageHeader from "@/components/PageHeader.astro";
import PostsPanel from "@/components/PostsPanel.astro";

const latestPosts = (await getCollection("blog"))
  .sort((a, b) => b.data.publishDate.getTime() - a.data.publishDate.getTime())
  .slice(0, 3);
---

<Layout
  title="Página não encontrada"
  description="A página que você procurou não existe ou mudou de endereço."
  noindex
>
  <div class="not-found">
    <PageHeader
      title="Página não encontrada"
      description="O endereço que você acessou não existe ou mudou de lugar."
    >
      <p class="not-found__links">
        <a href="/">Ir para a página inicial</a>
        <span aria-hidden="true">·</span>
        <a href="/blog/">Ver todos os posts</a>
      </p>
    </PageHeader>
    {
      latestPosts.length > 0 && (
        <PostsPanel
          title="Posts recentes"
          description="talvez você procure um destes"
          posts={latestPosts}
        />
      )
    }
  </div>
</Layout>

<style>
  .not-found {
    display: flex;
    flex-direction: column;
    gap: var(--space-l);
  }

  .not-found__links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-block-start: 0.5rem;
    color: var(--text-muted);
  }

  .not-found__links a {
    color: var(--text-main);
    text-decoration: underline;
    text-decoration-color: var(--text-muted);
    text-underline-offset: 3px;
  }

  .not-found__links a:hover {
    text-decoration-color: var(--text-main);
  }
</style>
